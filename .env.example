# Copy this file to .env and fill in real values before running
# docker compose up. Never commit the real .env file.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_DEBUG=False

# Comma-separated. Include your domain and/or server IP.
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Comma-separated origins allowed to call the API (your frontend's URL).
# Leave unset during local testing to allow all origins. Setting this also
# switches the session cookie to cross-site mode (SameSite=None; Secure) —
# required if the frontend and backend are on different domains (e.g.
# Vercel + Render), and requires the backend to be served over HTTPS.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- YOLO model ---
# Matches the mount path set in docker-compose.yml — leave as-is unless you
# change that mount.
YOLO_MODEL_PATH=/app/best.pt

# --- Optional: Postgres ---
# Uncomment these AND the `db` service + its volume in docker-compose.yml to
# move off SQLite. Leave commented to keep using SQLite (fine for a single
# instance / demo deployment).
# POSTGRES_DB=agrivision
# POSTGRES_USER=agrivision
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
