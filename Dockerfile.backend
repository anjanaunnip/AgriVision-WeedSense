FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System libraries required by opencv-python, pytesseract, and pdf2image
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    tesseract-ocr \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# NOTE: requirements.txt pins torch==2.10.0 / torchvision==0.25.0. Installing
# straight from PyPI pulls the default CUDA-enabled wheels, which are several
# GB. If this is deploying to a CPU-only host, install torch/torchvision from
# the PyTorch CPU wheel index first (uncomment below), THEN the rest of
# requirements.txt so pip doesn't re-resolve them from PyPI.
# RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 \
#       --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

COPY agrivision/ ./agrivision/
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

WORKDIR /app/agrivision
EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
